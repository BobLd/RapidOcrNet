<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<Version>4.0.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>BobLd;RapidOCR</Authors>
		<PackageTags>OCR;RapidOCR;PaddleOCR;PP-OCRv5;PPOCRv5;Document;skia;skiasharp;onnx;image</PackageTags>
		<RepositoryUrl>https://github.com/BobLd/RapidOcrNet</RepositoryUrl>
		<PackageProjectUrl>https://github.com/BobLd/RapidOcrNet</PackageProjectUrl>
		<Description>Lightweight cross-platform OCR processing library using PaddleOCR ONNX PP-OCR v5 models, and based on original code from RapidAI's RapidOCR. Also support v6 models (tiny / small / medium), see README.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageId>RapidOcrNet</PackageId>
		<Title>RapidOcrNet</Title>
		<Product>RapidOcrNet</Product>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>..\RapidOcrNet.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Clipper2" Version="2.0.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.29.0" />
		<PackageReference Include="SkiaSharp" Version="3.119.1" />
		<!--
		  NoDependencies rather than the default Linux native assets. The linux-arm64 binary in
		  SkiaSharp.NativeAssets.Linux 3.119.1 leaves uuid_generate_random, uuid_copy, uuid_parse
		  and uuid_unparse undefined while declaring no DT_NEEDED entry that provides them (the
		  linux-x64 binary of the same package needs libfontconfig.so.1 and references no uuid
		  symbols at all). The loader has nothing to resolve them against, so any arm64 Linux
		  consumer crashes on load with "undefined symbol: uuid_generate_random" — installing
		  fontconfig does not help, because the arm64 binary never asks for it.

		  The NoDependencies build links neither fontconfig nor uuid on either architecture. Its
		  only loss is the system font manager, and nothing here renders text: Skia is used for
		  bitmap resizing, canvas composition and path filling only.
		-->
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
	</ItemGroup>

	<ItemGroup>
		<None Update="models\v5\ch_PP-OCRv5_mobile_det.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v5\ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v5\latin_PP-OCRv5_rec_mobile_infer.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v5\ppocrv5_latin_dict.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- PP-OCRv6 models: copied to output for local builds/tests and for apps that place
	     them next to their binaries. Deliberately NOT packed into the NuGet (they total
	     ~176 MB); NuGet consumers opt into v6 by supplying their own files via a
	     RapidOcrModelSet. -->
	<ItemGroup>
		<None Update="models\v6\PP-OCRv6_det_tiny.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\PP-OCRv6_det_small.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\PP-OCRv6_det_medium.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\PP-OCRv6_rec_tiny.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\PP-OCRv6_rec_small.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\PP-OCRv6_rec_medium.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\ppocrv6_dict.txt">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\ppocrv6_tiny_dict.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Include="RapidOcrNet.targets" PackagePath="build/RapidOcrNet.targets" />
		<Content Include="models\v5\*.*" Pack="true" PackagePath="models\v5">
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="models\NewFolder\" />
	</ItemGroup>

</Project>