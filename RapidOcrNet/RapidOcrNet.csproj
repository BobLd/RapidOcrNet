<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<Version>2.0.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>BobLd;RapidOCR</Authors>
		<PackageTags>OCR;RapidOCR;PaddleOCR;PP-OCRv5;PPOCRv5;Document;skia;skiasharp;onnx;image</PackageTags>
		<RepositoryUrl>https://github.com/BobLd/RapidOcrNet</RepositoryUrl>
		<PackageProjectUrl>https://github.com/BobLd/RapidOcrNet</PackageProjectUrl>
		<Description>Lightweight cross-platform OCR processing library using PaddleOCR ONNX PP-OCR v5 models, and based on original code from RapidAI's RapidOCR.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageId>RapidOcrNet</PackageId>
		<Title>RapidOcrNet</Title>
		<Product>RapidOcrNet</Product>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>..\RapidOcrNet.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Clipper2" Version="2.0.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.27.0" />
		<PackageReference Include="SkiaSharp" Version="3.119.1" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
	</ItemGroup>

	<ItemGroup>
		<None Update="models\v5\ch_PP-OCRv5_mobile_det.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v5\ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v5\latin_PP-OCRv5_rec_mobile_infer.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v5\ppocrv5_latin_dict.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- PP-OCRv6 models: copied to output for local builds/tests and for apps that place
	     them next to their binaries. Deliberately NOT packed into the NuGet (they total
	     ~176 MB); NuGet consumers opt into v6 by supplying their own files via a
	     RapidOcrModelSet. -->
	<ItemGroup>
		<None Update="models\v6\PP-OCRv6_det_tiny.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\PP-OCRv6_det_small.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\PP-OCRv6_det_medium.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\PP-OCRv6_rec_tiny.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\PP-OCRv6_rec_small.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\PP-OCRv6_rec_medium.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\ppocrv6_dict.txt">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="models\v6\ppocrv6_tiny_dict.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Include="RapidOcrNet.targets" PackagePath="build/RapidOcrNet.targets" />
		<Content Include="models\v5\*.*" Pack="true" PackagePath="models\v5">
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="models\NewFolder\" />
	</ItemGroup>

</Project>